# ==============================================================================
# LexiClear — Environment Configuration
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Environment Mode: development | production | test
NODE_ENV=production

# Google Gemini API Key (Required for live AI document analysis & Q&A)
# Obtain your key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Configured Gemini Model (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# Rate Limiting Configuration (in-memory IP rate limiter)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_ANALYZE=20
RATE_LIMIT_MAX_QA=60
